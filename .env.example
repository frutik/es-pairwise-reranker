# TypeSafe Jev (https://console.typesafe.ai/keys)
RERANKER_JEV_API_KEY=
# RERANKER_JEV_MODEL=jev-latest
# Treat a comparison Jev wins with less than this probability as a tie (unset: never a tie)
# RERANKER_TIE_BAND=0.6

# How many hits are reranked: n of them cost n(n-1)/2 comparisons (20 -> 190)
# RERANKER_MAX_DOCUMENTS=20
# RERANKER_CONCURRENCY=16
# RERANKER_REQUEST_TIMEOUT_SECONDS=10
# Past this, the search's own order is returned
# RERANKER_TIME_BUDGET_SECONDS=8
# RERANKER_CACHE_SIZE=100000

# Callers (Elasticsearch) must send "Authorization: Bearer <this>" when it is set
RERANKER_SERVICE_API_KEY=

# Shared comparison cache (docker compose sets this). Unset: each process keeps its own, in memory
# RERANKER_REDIS_URL=redis://localhost:6379/0
# Expire cached comparisons after this many seconds (0: never; Redis's maxmemory policy still evicts)
# RERANKER_CACHE_TTL_SECONDS=0
# A Redis call slower than this counts as a cache miss
# RERANKER_REDIS_TIMEOUT_SECONDS=0.5
